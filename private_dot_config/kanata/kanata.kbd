;; global configuration options
;; Don't grab mice. They advertise a keyboard interface, so keyboard-only
;; detection is not enough to filter them out and they have to be named.
;; Grabbing them used to kill kanata with "failed read: No such device"
;; every time a wireless mouse slept, powered off or re-paired.
(defcfg
      process-unmapped-keys no
      log-layer-changes yes
      linux-device-detect-mode keyboard-only
      linux-continue-if-no-devs-found yes
      linux-dev-names-exclude (
            "Logitech MX Master 3"
            "Logitech MX Master 2S"
            "BY Tech Gaming Keyboard Mouse"
            "Mouse passthrough"
            "Mouse passthrough (absolute)"
      )
)

;; define keys that will be modified (all keys still processed)
(defsrc
      esc
      caps
      q w e
      a s d f g h j k l scln
      lalt spc ralt
)

;; default/base layer modifications always active
(deflayer default
      _
      @cap
      _ _ _
      _ _ _ _ _ _ _ _ _ _
      _ _ _
)

;; shifted layer activated by holding CAPS lock
(deflayer cap-mod
      _
      _
      @mmut @mvup @micm
      @mprv @mvdn @mnxt _ _ left down up rght _
      _     @mtog _
)

;; values used by multiple changes
(defvar
      double-tap-time 200
      tap-time 200
      hold-time 250
)

(deflocalkeys-linux
      micmute 248
)

(deflocalkeys-winiov2
      micmute 1
)


;; remapping between physical keys and functionality
(defalias
      capsword (tap-dance $double-tap-time (XX caps))
      cap (tap-hold-press $tap-time $hold-time @capsword (layer-toggle cap-mod))
      micm micmute
      mmut mute   ;; 🔇
      mtog pp     ;; ▶⏸
      mnxt next   ;; ▶▶
      mprv prev   ;; ◀◀
      mvup volu   ;; 🔊
      mvdn voldwn ;; 🔉
      ;;mbck mute
)
