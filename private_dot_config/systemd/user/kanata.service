[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata
StartLimitIntervalSec=0

[Service]
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/bin
Environment=DISPLAY=:0
Type=simple
ExecStart=%h/.local/bin/kanata

; Always come back, no matter how it died. StartLimitIntervalSec=0 above
; disables systemd's give-up-after-5-restarts rule, so a keyboard that is
; unplugged for a while can never leave the service permanently dead.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
