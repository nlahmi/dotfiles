{
  "autoMode": {
    "classifierReasoningLevel": "low",
    "allowInsideWorkingDirectory": true,
    "deniedPaths": [
      "**/.env",
      "**/.env.*",
      "~/.aws/credentials",
      "~/.ssh/id_*",
      "~/.pi/agent/auth.json"
    ],
    "environment": [
      "$defaults"
    ],
    "allow": [
      "$defaults"
    ],
    "protectedPaths": [
      "$defaults"
    ],
    "soft_deny": [
      "$defaults"
    ],
    "hard_deny": [
      "$defaults"
    ]
  },
  "permissions": {
    "deny": [
      "bash(sudo *)"
    ],
    "ask": [
      "bash(git push*)"
    ],
    "allow": [
      "bash(git status*)",
      "bash(git diff*)",
      "bash(git log*)",
      "bash(git show*)",
      "bash(ls*)"
    ]
  }
}
